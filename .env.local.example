# Potesjarm – miljøvariabler
#
# Kopier denne fila til .env.local (som IKKE committes) for lokal utvikling,
# og legg de samme verdiene inn i Vercel -> Settings -> Environment Variables
# for produksjon.

# --- Supabase (Sprint 1: auth + profiles + dogs) ---------------------------
# Finnes i Supabase-dashbordet: Project Settings -> API.
# Anon-nøkkelen er ment for klienten og trygg å eksponere – all sikkerhet
# håndheves av Row Level Security i supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://DITT-PROSJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-key

# --- Venteliste (Formspree) ------------------------------------------------
# Uten denne faller ventelistesiden ærlig tilbake på en mailto-lenke.
NEXT_PUBLIC_WAITLIST_FORM_URL=

# --- Testing (settes automatisk av Playwright, ikke i produksjon) ----------
# NEXT_PUBLIC_WAITLIST_MODE=off      # viser appen i stedet for ventelisten
# NEXT_PUBLIC_FORCE_ONBOARDING=on    # tvinger onboarding for e2e
